# SkypeRTC deploy config

# HTTP server
HOST=
PORT=8080
STATIC_DIR=./static

# TLS (optional). Leave empty for plain HTTP (only OK on localhost).
TLS_CERT=
TLS_KEY=

# ICE servers (comma-separated URLs)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN — required for clients behind symmetric NAT / strict firewalls.
# Example for coturn:
#   TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# WebSocket origin allow-list (comma-separated). Empty = allow all (dev mode).
# In production set to the public URL(s) of your deployment.
#   ALLOWED_ORIGINS=https://meet.example.com,https://www.meet.example.com
ALLOWED_ORIGINS=
